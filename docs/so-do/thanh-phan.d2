# Hình 3 — Thành phần trong cụm và ai gọi ai.
...@chung

direction: right

title: |md
  # Thành phần trong cụm — ai gọi ai
| {near: top-center}

user: "Người dùng\nhttps://*.talos.internal" {class: ngoai; shape: person; width: 120; height: 110}
git: "talos-gitops" {class: ngoai; icon: ${si}/github}

ingress: "Lối vào" {
  class: nentang
  traefik: "Traefik\ningress + TLS nội bộ" {icon: ${si}/traefikproxy}
  certm: "cert-manager\nCA nội bộ" {icon: ${cncf}/cert-manager/icon/color/cert-manager-icon-color.svg}
  certm -> traefik: "chứng chỉ" {class: phu}
}

gitops: "Triển khai" {
  class: nentang
  argocd: "Argo CD\n22 app, self-heal" {icon: ${cncf}/argo/icon/color/argo-icon-color.svg}
  rollouts: "Argo Rollouts\nblue-green + phân tích" {icon: ${cncf}/argo/icon/color/argo-icon-color.svg}
  sealed: "Sealed Secrets\ngiải mã secret trong Git"
}

sec: "Bảo mật" {
  class: baomat
  kyverno: "Kyverno\nchỉ image ký bằng khoá Jenkins" {icon: ${cncf}/kyverno/icon/color/kyverno-icon-color.svg}
  vap: "ValidatingAdmissionPolicy\nbắt buộc request RAM"
  vault: "Vault\nsecret của ứng dụng" {icon: ${si}/vault}
  eso: "External Secrets\nVault → Secret"
  eso -> vault: "đọc" {class: phu}
}

ghcr: "GHCR (ngoài cụm)\nimage + chữ ký" {class: db; icon: ${si}/github}

storage: "Lưu trữ" {
  class: nentang
  longhorn: "Longhorn\n2 bản sao trên w1 và w2" {icon: ${cncf}/longhorn/icon/color/longhorn-icon-color.svg}
  localpath: "local-path\nghim vào một node"
}

app: "Ứng dụng demo-app" {
  class: ungdung
  active: "Bản active"
  preview: "Bản preview"
  preview -> active: "đạt smoke, tỉ lệ lỗi, ZAP" {class: phu}
}

idp: "Danh tính" {
  class: danhtinh
  keycloak: "Keycloak\nSSO OIDC/SAML" {icon: ${cncf}/keycloak/icon/color/keycloak-icon-color.svg}
  oauth2: "oauth2-proxy"
  headlamp: "Headlamp\ngiao diện cụm"
  oauth2 -> keycloak: "đăng nhập" {class: phu}
  headlamp -> keycloak: "đăng nhập" {class: phu}
}

mon: "Giám sát" {
  class: giamsat
  prom: "Prometheus" {icon: ${cncf}/prometheus/icon/color/prometheus-icon-color.svg}
  am: "Alertmanager" {icon: ${cncf}/prometheus/icon/color/prometheus-icon-color.svg}
  grafana: "Grafana" {icon: ${si}/grafana}
  prom -> am: "luật cảnh báo" {class: phu}
  grafana -> prom: "truy vấn" {class: phu}
}

logs: "Log tập trung" {
  class: giamsat
  otel: "OpenTelemetry Collector\nDaemonSet 4 node, đọc /var/log/pods" {icon: ${si}/opentelemetry}
  vlogs: "VictoriaLogs\nlưu 7 ngày, trên w3"
  otel -> vlogs: "OTLP" {class: luong}
}

bk: "Backup trong cụm" {
  class: nentang
  velero: "Velero\nobject Kubernetes, 09:30 T2–T6, trên w3" {icon: ${cncf}/velero/icon/color/velero-icon-color.svg}
}

gcs: "Google Cloud Storage\nbucket riêng của Velero" {class: db; icon: ${si}/googlecloud
}

user -> ingress.traefik: "HTTPS" {class: luong}
ingress.traefik -> app.active: {class: luong}
ingress.traefik -> idp.keycloak: {class: phu}
ingress.traefik -> mon.grafana: {class: phu}
ingress.traefik -> idp.oauth2: "Prometheus, Alertmanager" {class: phu}
git -> gitops.argocd: "trạng thái mong muốn" {class: luong}
gitops.argocd -> gitops.rollouts: "Rollout" {class: phu}
gitops.rollouts -> app.preview: "tạo bản mới" {class: luong}
ghcr -> app.preview: "image" {class: luong}
sec.kyverno -> app.preview: "kiểm chữ ký" {class: kiem}
sec.kyverno -> ghcr: "đọc chữ ký" {class: kiem}
mon.grafana -> storage.longhorn: "PV" {class: phu}
sec.vault -> storage.localpath: "PV (sắp sang Longhorn)" {class: phu}
mon.prom -> storage.localpath: "PV trên w3" {class: phu}
sec.eso -> app.active: ".env" {class: phu}
mon.prom -> app.active: "thu metric" {class: phu}
app.active -> logs.otel: "log pod" {class: luong}
mon.grafana -> logs.vlogs: "dashboard Log tập trung" {class: phu}
bk.velero -> gcs: "backup hằng ngày" {class: luong}

note: |md
  Grafana, Argo CD, Headlamp, Vault đăng nhập qua Keycloak (SSO); Prometheus và Alertmanager qua oauth2-proxy. Collector thu log của mọi pod, không riêng demo-app.
| {class: chu; near: bottom-center}
