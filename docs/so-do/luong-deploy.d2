# Hình 4 — Luồng đưa code lên production.
...@chung

direction: down

title: |md
  # Luồng đưa code lên production (~12 phút, đo 28/10)
| {near: top-center}

dev: "Lập trình viên\npush code" {class: ngoai; shape: person; width: 110; height: 100}
github: "GitHub\ntalos-demo-app" {class: ngoai; icon: ${si}/github; label.near: top-center; icon.near: bottom-center; height: 130}
jenkins: "Jenkins trên Google Cloud" {
  class: baomat
  icon: ${si}/jenkins
  ma: "Quét mã nguồn" {
    class: baomat
    gitleaks: "1. gitleaks\nquét toàn bộ lịch sử Git"
    test: "2. go test + coverage\ngovulncheck · gosec"
    sonar: "3. SonarQube\nquality gate"
    gitleaks -> test -> sonar: {class: luong}
  }
  build: "4. build amd64 + arm64\nđẩy GHCR một lần"
  image: "Quét image + ký" {
    class: baomat
    trivy: "5. Trivy\nquét đúng digest + SBOM"
    sign: "6. cosign\nký image"
    trivy -> sign: {class: luong}
  }
  ma.sonar -> build -> image.trivy: {class: luong}
}
ghcr: "GHCR\nnhận image đã ký" {class: db; icon: ${si}/github; label.near: top-center; icon.near: bottom-center; height: 130}
gitops: "talos-gitops\nnewTag mới" {class: ngoai; icon: ${si}/github; label.near: top-center; icon.near: bottom-center; height: 130}
argocd: "Argo CD\nđồng bộ Rollout" {class: nentang; icon: ${cncf}/argo/icon/color/argo-icon-color.svg; label.near: top-center; icon.near: bottom-center; height: 130}
harbor: "Harbor nội bộ\nreplicate 10 phút/lần" {class: nentang; icon: ${cncf}/harbor/icon/color/harbor-icon-color.svg; label.near: top-center; icon.near: bottom-center; height: 130}
kyverno: "Kyverno\nkhông có chữ ký Jenkins = từ chối" {class: baomat; icon: ${cncf}/kyverno/icon/color/kyverno-icon-color.svg; label.near: top-center; icon.near: bottom-center; height: 130}
preview: "Bản preview\nsmoke · tỉ lệ lỗi · ZAP (DAST)" {class: ungdung; icon: ${cncf}/argo/icon/color/argo-icon-color.svg; label.near: top-center; icon.near: bottom-center; height: 130}
zap: "OWASP ZAP\nDAST: quét app đang chạy" {class: baomat}
active: "Bản active\nnhận traffic; bản cũ giữ 10 phút" {class: ungdung}

dev -> github: {class: luong}
github -> jenkins.ma.gitleaks: "poll 5 phút" {class: luong}
jenkins.image.sign -> ghcr: {class: luong}
jenkins.image.sign -> gitops: "sửa tag" {class: luong}
gitops -> argocd: {class: luong}
ghcr -> harbor: "kèm chữ ký" {class: luong}
argocd -> preview: {class: luong}
harbor -> preview: "kéo image 5–7 s" {class: luong}
kyverno -> preview: "kiểm khi tạo pod" {class: kiem}
zap -> preview: "DAST trên bản preview" {class: kiem}
preview -> active: "đạt cả 3 kiểm tra" {class: luong}

note: |md
  Cổng nào lỗi thì pipeline dừng, không có image được ký. Image không ký bị Kyverno từ chối, kể cả khi lấy từ Harbor.
| {class: chu; near: bottom-center}
