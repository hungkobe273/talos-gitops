# Phần dùng chung cho mọi sơ đồ (import bằng ...@chung).
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
  cncf: https://raw.githubusercontent.com/cncf/artwork/main/projects
  si: https://cdn.simpleicons.org
}

classes: {
  ngoai: {style: {fill: "#f4f6f8"; stroke: "#8a96a3"; stroke-dash: 4; border-radius: 8; font-size: 18}}
  nentang: {style: {fill: "#e3f1f3"; stroke: "#0e6a76"; border-radius: 8; font-size: 18}}
  baomat: {style: {fill: "#fbeee3"; stroke: "#a8571b"; border-radius: 8; font-size: 18}}
  ungdung: {style: {fill: "#e8f3e6"; stroke: "#3a7d2c"; border-radius: 8; font-size: 18}}
  giamsat: {style: {fill: "#efeaf7"; stroke: "#5b3fa0"; border-radius: 8; font-size: 18}}
  danhtinh: {style: {fill: "#e9eef8"; stroke: "#2f5aa8"; border-radius: 8; font-size: 18}}
  db: {shape: cylinder; style: {fill: "#ffffff"; stroke: "#5b6876"; font-size: 17}}
  he: {style: {fill: "#0e6a76"; stroke: "#0b5560"; font-color: "#ffffff"; border-radius: 12; font-size: 22; bold: true}}
  luong: {style: {stroke: "#0e6a76"; stroke-width: 3; animated: true; font-color: "#0e6a76"; bold: true; font-size: 16}}
  kiem: {style: {stroke: "#a8571b"; stroke-width: 2; stroke-dash: 4; font-color: "#a8571b"; font-size: 15}}
  phu: {style: {stroke: "#5b6876"; stroke-width: 2; font-color: "#5b6876"; font-size: 15}}
  chu: {shape: text; style: {font-size: 16; font-color: "#24303c"}}
}
