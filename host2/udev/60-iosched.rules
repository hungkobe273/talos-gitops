# 10/11 (docs/de-xuat-bfq.md): HDD dung BFQ de trong so blkio cua VM (cp1 1000) va IOSchedulingClass=idle co tac dung.
# Cai: sudo install -m 644 host2/udev/60-iosched.rules /etc/udev/rules.d/ && sudo udevadm control --reload
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
